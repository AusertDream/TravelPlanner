# ── 密钥：任何 .env 都不提交（模板 .env.example 除外）──
.env
.env.*
!.env.example

# ── 运行产物 ──
.mapcache/
.install.json
_tmp/
*.check.png
node_modules/
__pycache__/
*.py[cod]
*.log

# ── 系统 / 编辑器 ──
.DS_Store
Thumbs.db
.vscode/
.idea/

# ── 个人临时目录 ──
temp/

# ── 宣传片发布物：成片、封面、字幕、发布文案（成片 170 MB，超过 GitHub 单文件上限）。构建源码在 video-src/ ──
video/
# 视频源码目录里也不收音视频文件
video-src/**/*.mp4
video-src/**/*.wav
video-src/**/*.mp3
video-src/**/*.m4a
video-src/**/*.f32
