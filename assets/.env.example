# ══════════════════════════════════════════════════════════════════════
#  旅行规划助手 Agent (Travel Planner Agent) — 配置文件样例
# ══════════════════════════════════════════════════════════════════════
#  用法：安装脚本已经把本文件复制成同目录的 .env，直接编辑 .env 填 Key 即可；
#  没有 .env 时手动复制：cp .env.example .env
#  填完检查：node doctor.mjs（缺什么、去哪申请都会列出来）
#
#  说明：
#   · .env 是本 Agent 唯一的密钥存放处；preset 的 travel-env 插件在会话
#     启动时把它注入进程环境，所有工具（amap-gui / flyai / tuniu）
#     都从环境变量读取，代码与文档中不出现任何明文 Key。
#   · .env 已被 .gitignore 忽略，请勿提交或分发。
#   · 必需：高德（AMAP_KEY + AMAP_SECURITY_KEY）、飞猪（FLYAI_API_KEY）。
#     其余可选，留空时对应能力自动降级。
#   · 格式：NAME=值，等号两边不要空格；值里有空格（如路径）就用双引号括起来。保存即生效（run.sh 每次现读），不用重启 DSH。
#   · 占位值（PLACEHOLDER_* / your_*）会被插件自动跳过，不会误当真实 Key 使用。
#   · 联网搜索（agent-reach / Exa / Jina Reader）**不需要任何 Key**，
#     因此本文件没有对应变量。
# ══════════════════════════════════════════════════════════════════════

# ── 高德地图【必需】（amap-gui CLI：POI 搜索 / 路径规划 / 地图控制）──────
# 申请：https://console.amap.com/dev/key/app
#   1) 注册登录高德开放平台（个人开发者即可，免费额度够用）
#   2) 「应用管理」→ 创建新应用 → 「添加 Key」
#   3) 服务平台选择「Web端(JS API)」，提交后得到 AMAP_KEY（32 位）
#   4) 同一行的「安全密钥」（securityJsCode）→ AMAP_SECURITY_KEY
AMAP_KEY=your_amap_web_js_api_key
AMAP_SECURITY_KEY=your_amap_js_api_security_key

# ── 飞猪旅行 AI 开放平台【必需】（flyai CLI：机票 / 酒店 / 景点 / 火车票）
# 申请：https://flyai.open.fliggy.com/
#   1) 注册并完成平台实名认证
#   2) 在控制台领取 API Key
#   3) 留空时 CLI 走「体验模式」：机票价格基本准，但酒店价格会被遮蔽成 ¥3xx 这种，
#      三档酒店推荐做不出来——所以算必需
FLYAI_API_KEY=

# ── 途牛【可选】（tuniu CLI：机票 / 酒店 / 门票 / 度假 / 邮轮）
# 通常无需 Key：使用 OAuth 网页授权即可
#     tuniu auth login --daemon       # 打开输出的授权链接完成登录
# 如需 API Key 兜底：https://open.tuniu.com
TUNIU_API_KEY=

# ── Unsplash【可选】（路书配图 → photo-fetch.py）─────────────────────────
# 申请：https://unsplash.com/developers
#   1) 注册 → 「Your apps」→ New Application → 同意 API 使用条款
#   2) 复制 Access Key（**不是** Secret Key）
# 提示：Unsplash 是「氛围图库」——
#   · 搜**题材词**（bamboo forest / water town China / misty mountain）效果最好；
#   · 搜**具体地名**基本没用（实测中文"莫干山"出的是通用高山照，英文 Moganshan 直接搜不到）。
#   · 脚本默认抓 3 个候选，**务必用 read_image 看过再挑**。
# 脚本另有 --source wiki 备用（Wikimedia，免 key），日常不需要。
UNSPLASH_ACCESS_KEY=

# ── 可选：HTTP 代理（访问境外资源：Wikimedia 配图、境外网页）─────────────
# 国内站点（高德/12306/飞猪/途牛）会自动直连（run.sh 已写好 NO_PROXY 白名单）
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890

# ── 可选：非常规安装位置 ─────────────────────────────────────────────────
# Chrome / Edge 不在默认位置时（真实路线、截图、交付检查要用无头浏览器）
# CHROME_PATH="C:/Program Files/Google/Chrome/Application/chrome.exe"
# 指定 Python 解释器（默认依次找 python、python3）
# PYTHON=python3

# ── Google Maps【可选增强】───────────────────────────────────────────────
# 用途：map-widget.py 生成的路书地图，有 key 时页面打开即加载可拖动的 Google 地图
#       （编号点 + 中文名 + 路线）；没 key / 连不上 Google 会自动降级到无 key 嵌入、
#       高德瓦片可拖动地图、静态图，绝不白屏。
# 申请：https://console.cloud.google.com/google/maps-apis/credentials
#       → 创建项目 → 启用 **Maps JavaScript API** → 创建 API 密钥
# 必做的限制（key 会明文写进路书 HTML，路书会被转发）：
#   · API 限制：只勾 Maps JavaScript API
#   · 配额：设每日上限
#   · **不要**加「网站(HTTP referrer)」限制 —— 路书用 file:// 打开没有 Referer，加了就报错
# 留空会怎样：不影响任何功能，地图从「Google 无 key 嵌入」那层开始。
# 不想让某份路书带 key：生成时加 --no-google-key。
GOOGLE_MAPS_API_KEY=
